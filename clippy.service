[Unit]
Description=Clippy clipboard sync
Documentation=https://github.com/gjvanouwendorp/clippy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gjvanouwendorp
Group=gjvanouwendorp
WorkingDirectory=/var/www/clippy

Environment=NODE_ENV=production
Environment=PORT=3000

# Absolute path: systemd does not load the user's nvm shell environment.
ExecStart=/home/gjvanouwendorp/.nvm/versions/node/v22.18.0/bin/node /var/www/clippy/server.js

Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clippy

# Hardening — the app only reads its own files and listens on a local port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/www/clippy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
